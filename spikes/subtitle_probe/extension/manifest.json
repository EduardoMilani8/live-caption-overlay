{
  "manifest_version": 3,
  "name": "Live Caption Probe",
  "version": "0.1.0",
  "description": "Spike: logs Netflix/YouTube subtitles and player timing to a local receiver.",
  "browser_specific_settings": {
    "gecko": {
      "id": "live-caption-probe@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.youtube.com/*",
    "http://127.0.0.1/*"
  ],
  "background": { "scripts": ["background.js"] },
  "action": { "default_title": "Live Caption Probe" },
  "content_scripts": [
    {
      "matches": ["*://*.netflix.com/*", "*://*.youtube.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.netflix.com/*", "*://*.youtube.com/*"],
      "js": ["probe.js"],
      "run_at": "document_start"
    }
  ]
}
